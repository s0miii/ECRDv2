# ========================
# Global ignores
# ========================
# OS / editor files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# Python / Django
# ========================
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
db.sqlite3

# Virtual environments
venv/
.venv/

# Django media/static
media/
staticfiles/

# ========================
# Node.js / Next.js
# ========================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing / Coverage
coverage/
.nyc_output/

# ========================
# Environment / Secrets
# ========================
.env
.env*.local
*.pem

# ========================
# Frontend (Next.js + Tailwind + ShadCN)
# ========================

# Tailwind build artifacts
*.css.map
postcss.config.js

# ShadCN UI build cache
/components.json

# Local Next.js analytics / telemetry
.next/cache/
.next/static/

# Local fonts (if downloaded manually)
public/fonts/

# Local images or build assets
public/assets/
public/uploads/

# Package manager artifacts
package-lock.json
yarn.lock
pnpm-lock.yaml

# VSCode & JetBrains settings (frontend)
.vscode/
.idea/

# Misc frontend caches
.cache/


# Deployment
.vercel
