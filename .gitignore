# ========================
# Global ignores
# ========================
# OS / editor files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# Python / Django
# ========================
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3
db.sqlite3
migrations/

# Virtual environments
venv/
.venv/

# Django media/static (optional if you’re storing locally)
media/
staticfiles/

# ========================
# Node.js / Next.js
# ========================
node_modules/
.next/
out/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Env files (keep your secrets safe!)
.env
.env*.local

# Coverage / testing
coverage/
.nyc_output/
